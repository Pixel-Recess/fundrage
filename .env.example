# FundRage backend — environment template. Never commit real values.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
REDIS_URL=redis://localhost:6379

# Session tokens
JWT_SECRET=change-me

# Sign in with Apple
APPLE_BUNDLE_ID=com.fundrage.app
APPLE_JWKS_URL=https://appleid.apple.com/auth/keys
APPLE_ISSUER=https://appleid.apple.com

# Global kill switch (spec §6)
PUSH_ENABLED=false

# Ingestion worker (spec §4.1) — exploratory, not yet an official build phase
INGESTION_INTERVAL_MINUTES=5
GDELT_QUERY=sourcelang:english
INGESTION_DEDUPE_TTL_HOURS=48

# Live demo data (experimental, unauthenticated /dev/* routes — no persistence)
# Free self-serve key from https://www.every.org/charity-api — leave unset to disable /dev/charities.
EVERY_ORG_API_KEY=
# Frontend origin allowed to call the API cross-origin (Vercel deploy URL in production).
FRONTEND_ORIGIN=http://localhost:5173

# Every.org donation rail (Phase 1 — spec §9). Use https://staging.every.org for local/dev testing.
EVERY_ORG_BASE_URL=https://www.every.org
# "Webhook Token" from the Every.org developer dashboard — embedded in outbound Donate Links.
EVERY_ORG_WEBHOOK_TOKEN=
# "Auth Token" from the Every.org developer dashboard — checked against inbound webhook requests'
# Authorization header. UNCONFIRMED mechanism — see Phase 1 plan; do not trust in production yet.
EVERY_ORG_WEBHOOK_AUTH_TOKEN=
